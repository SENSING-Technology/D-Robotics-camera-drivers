// SPDX-License-Identifier: GPL-2.0
/*
 * D-Robotics S600: 16-channel sensing camera overlay
 *
 * RX0..RX3 each connect one MAX96712. Each MAX96712 uses Port A..D
 * and transports four YUV422 streams on VC0..VC3.
 *
 * RX1 board resources are inferred from the RX0/RX2/RX3 numbering pattern:
 *   PWDN peri_port0[5], PoC gpio_exp_27[1], PWM lpwm0 channel 2.
 * Verify these three assignments against the S600 MCB schematic before use.
 */

#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "/soc/i2c@34840000/"; /* I2C0 */
		__overlay__ {
			status = "disabled";
			clock-frequency = <100000>;

			rx0_dser: rx0_max96712@29 {
				compatible = "d-robotics,max96712";
				reg = <0x29>;
				phy_type = <0>; /* D-PHY */
				phy_speed = <2500>; /* 2.5 Gbps per lane */
				sensing,trigger-period-ns = <33333333>;
				sensing,trigger-duty-ns = <10000>;
				pwdn-gpios = <&peri_port0 4 GPIO_ACTIVE_HIGH>;
				poc_en-gpios = <&gpio_exp_27 0 GPIO_ACTIVE_HIGH>;
				soc_trig_pin = <5>;
				pwms = <&lpwm0 0 33333000 20000>;
				pwm-names = "sync";
				trig_src = <0>;
				trig_mode = <1>;
				status = "okay";
			};

			rx0_ser_prim: rx0_max9295_prim@40 {
				compatible = "d-robotics,max9295";
				reg = <0x40>;
				is-prim-ser;
				rx_index = <0>;
				status = "okay";
			};

			rx0_ser_a: rx0_max9295_a@41 {
				compatible = "d-robotics,max9295";
				reg = <0x41>;
				link-port = <0>;
				rx_index = <0>;
				status = "okay";
			};

			rx0_sensing_a@11 {
				compatible = "sensing,sensing-cam";
				reg = <0x11>;
				addr = <0x10>;
				width = <3840>;
				height = <2160>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx0_ser_a>;
				d-robotics,serdes-dser-device = <&rx0_dser>;
				status = "okay";

				port {
					rx0_sensor_a_out: endpoint {
						remote-endpoint = <&rx0_mipi_vc0_in>;
						virtual-channel = <0>;
					};
				};
			};

			rx0_ser_b: rx0_max9295_b@42 {
				compatible = "d-robotics,max9295";
				reg = <0x42>;
				link-port = <1>;
				rx_index = <0>;
				status = "okay";
			};

			rx0_sensing_b@12 {
				compatible = "sensing,sensing-cam";
				reg = <0x12>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx0_ser_b>;
				d-robotics,serdes-dser-device = <&rx0_dser>;
				status = "okay";

				port {
					rx0_sensor_b_out: endpoint {
						remote-endpoint = <&rx0_mipi_vc1_in>;
						virtual-channel = <1>;
					};
				};
			};

			rx0_ser_c: rx0_max9295_c@43 {
				compatible = "d-robotics,max9295";
				reg = <0x43>;
				link-port = <2>;
				rx_index = <0>;
				status = "okay";
			};

			rx0_sensing_c@13 {
				compatible = "sensing,sensing-cam";
				reg = <0x13>;
				addr = <0x10>;
				width = <1920>;
				height = <1536>;
				data_type = <0x1e>;
				gmsl-link-rate = <3>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx0_ser_c>;
				d-robotics,serdes-dser-device = <&rx0_dser>;
				status = "okay";

				port {
					rx0_sensor_c_out: endpoint {
						remote-endpoint = <&rx0_mipi_vc2_in>;
						virtual-channel = <2>;
					};
				};
			};

			rx0_ser_d: rx0_max9295_d@44 {
				compatible = "d-robotics,max9295";
				reg = <0x44>;
				link-port = <3>;
				rx_index = <0>;
				status = "okay";
			};

			rx0_sensing_d@14 {
				compatible = "sensing,sensing-cam";
				reg = <0x14>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx0_ser_d>;
				d-robotics,serdes-dser-device = <&rx0_dser>;
				status = "okay";

				port {
					rx0_sensor_d_out: endpoint {
						remote-endpoint = <&rx0_mipi_vc3_in>;
						virtual-channel = <3>;
					};
				};
			};
		};
	};

	fragment@1 {
		target-path = "/soc/i2c@34841000/"; /* I2C1 */
		__overlay__ {
			status = "disabled";
			clock-frequency = <100000>;

			rx1_dser: rx1_max96712@29 {
				compatible = "d-robotics,max96712";
				reg = <0x29>;
				phy_type = <1>; /* C-PHY */
				phy_speed = <3648>; /* C-PHY 1600 Msps/trio: DPLL code 0x10 */
				sensing,trigger-period-ns = <33333333>;
				sensing,trigger-duty-ns = <10000>;
				pwdn-gpios = <&peri_port0 5 GPIO_ACTIVE_HIGH>;
				poc_en-gpios = <&gpio_exp_27 1 GPIO_ACTIVE_HIGH>;
				soc_trig_pin = <5>;
				pwms = <&lpwm0 2 33333000 20000>;
				pwm-names = "sync";
				trig_src = <0>;
				trig_mode = <1>;
				status = "okay";
			};

			rx1_ser_prim: rx1_max9295_prim@40 {
				compatible = "d-robotics,max9295";
				reg = <0x40>;
				is-prim-ser;
				rx_index = <1>;
				status = "okay";
			};

			rx1_ser_a: rx1_max9295_a@41 {
				compatible = "d-robotics,max9295";
				reg = <0x41>;
				link-port = <0>;
				rx_index = <1>;
				status = "okay";
			};

			rx1_sensing_a@11 {
				compatible = "sensing,sensing-cam";
				reg = <0x11>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				stereo_left; 
				d-robotics,serdes-ser-device = <&rx1_ser_a>;
				d-robotics,serdes-dser-device = <&rx1_dser>;
				status = "okay";

				port {
					rx1_sensor_a_out: endpoint {
						remote-endpoint = <&rx1_mipi_vc0_in>;
						virtual-channel = <0>;
					};
				};
			};

			rx1_ser_b: rx1_max9295_b@42 {
				compatible = "d-robotics,max9295";
				reg = <0x42>;
				link-port = <1>;
				rx_index = <1>;
				status = "okay";
			};

			rx1_sensing_b@12 {
				compatible = "sensing,sensing-cam";
				reg = <0x12>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				stereo_right; 
				d-robotics,serdes-ser-device = <&rx1_ser_b>;
				d-robotics,serdes-dser-device = <&rx1_dser>;
				status = "okay";

				port {
					rx1_sensor_b_out: endpoint {
						remote-endpoint = <&rx1_mipi_vc1_in>;
						virtual-channel = <1>;
					};
				};
			};

			rx1_ser_c: rx1_max9295_c@43 {
				compatible = "d-robotics,max9295";
				reg = <0x43>;
				link-port = <2>;
				rx_index = <1>;
				status = "okay";
			};

			rx1_sensing_c@13 {
				compatible = "sensing,sensing-cam";
				reg = <0x13>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx1_ser_c>;
				d-robotics,serdes-dser-device = <&rx1_dser>;
				status = "okay";

				port {
					rx1_sensor_c_out: endpoint {
						remote-endpoint = <&rx1_mipi_vc2_in>;
						virtual-channel = <2>;
					};
				};
			};

			rx1_ser_d: rx1_max9295_d@44 {
				compatible = "d-robotics,max9295";
				reg = <0x44>;
				link-port = <3>;
				rx_index = <1>;
				status = "okay";
			};

			rx1_sensing_d@14 {
				compatible = "sensing,sensing-cam";
				reg = <0x14>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx1_ser_d>;
				d-robotics,serdes-dser-device = <&rx1_dser>;
				status = "okay";

				port {
					rx1_sensor_d_out: endpoint {
						remote-endpoint = <&rx1_mipi_vc3_in>;
						virtual-channel = <3>;
					};
				};
			};
		};
	};

	fragment@2 {
		target-path = "/soc/i2c@34842000/"; /* I2C2 */
		__overlay__ {
			status = "okay";
			clock-frequency = <100000>;

			rx2_dser: rx2_max96712@29 {
				compatible = "d-robotics,max96712";
				reg = <0x29>;
				phy_type = <0>; /* D-PHY */
				phy_speed = <2500>; /* 2.5 Gbps per lane */
				sensing,trigger-period-ns = <33333333>;
				sensing,trigger-duty-ns = <10000>;
				pwdn-gpios = <&peri_port0 6 GPIO_ACTIVE_HIGH>;
				poc_en-gpios = <&gpio_exp_27 2 GPIO_ACTIVE_HIGH>;
				soc_trig_pin = <5>;
				pwms = <&lpwm3 0 33333333 10000>;
				pwm-names = "sync";
				trig_src = <0>;
				trig_mode = <0>;
				status = "okay";
			};

			rx2_ser_prim: rx2_max9295_prim@40 {
				compatible = "d-robotics,max9295";
				reg = <0x40>;
				is-prim-ser;
				rx_index = <2>;
				status = "okay";
			};

			rx2_ser_a: rx2_max9295_a@41 {
				compatible = "d-robotics,max9295";
				reg = <0x41>;
				link-port = <0>;
				rx_index = <2>;
				status = "disabled";
			};
			rx2_s56@22 {
				compatible = "sensing,s56-gmsl2";
				reg = <0x22>;
				link-port = <0>;
				gmsl-link-rate = <6>;
				width = <2560>;
				height = <1984>;
				sensing,sensor-default-addresses = <0x10 0x11>;
				sensing,sensor-alias-addresses = <0x22 0x23>;
				sensing,serializer-alias = <0x41>;
				sensing,stream-pipes = <0 1>;
				sensing,stream-dst-vcs = <0 1>;
				sensing,trigger-mode = <1>;
				sensing,trigger-mfp = <7>;
				sensing,trigger-gpio-id = <7>;
				sensing,trigger-period-ns = <33333333>;
				sensing,trigger-duty-ns = <10000>;
				d-robotics,serdes-dser-device = <&rx2_dser>;
				status = "okay";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						rx2_sensor_a_out_0: endpoint {
							remote-endpoint = <&rx2_mipi_vc0_in>;
							virtual-channel = <0>;
						};
					};
					port@1 {
						reg = <1>;
						rx2_sensor_a_out_1: endpoint {
							remote-endpoint = <&rx2_mipi_vc1_in>;
							virtual-channel = <1>;
						};
					};
				};
			};

			rx2_ser_b: rx2_max9295_b@42 {
				compatible = "d-robotics,max9295";
				reg = <0x42>;
				link-port = <1>;
				rx_index = <2>;
				status = "disabled";
			};

			rx2_sensing_b@12 {
				compatible = "sensing,sensing-cam";
				reg = <0x12>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx2_ser_b>;
				d-robotics,serdes-dser-device = <&rx2_dser>;
				status = "disabled";

				port {
					rx2_sensor_b_out: endpoint {
						virtual-channel = <1>;
					};
				};
			};

			rx2_ser_c: rx2_max9295_c@43 {
				compatible = "d-robotics,max9295";
				reg = <0x43>;
				link-port = <2>;
				rx_index = <2>;
				status = "okay";
			};

			rx2_sensing_c@13 {
				compatible = "sensing,sensing-cam";
				sensing,model = "SG8-OX08DC-5300-G2G-Hxxx";
				reg = <0x13>;
				addr = <0x10>;
				width = <3840>;
				height = <2160>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx2_ser_c>;
				d-robotics,serdes-dser-device = <&rx2_dser>;
				status = "okay";

				port {
					rx2_sensor_c_out: endpoint {
						remote-endpoint = <&rx2_mipi_vc2_in>;
						virtual-channel = <2>;
					};
				};
			};

			rx2_ser_d: rx2_max9295_d@44 {
				compatible = "d-robotics,max9295";
				reg = <0x44>;
				link-port = <3>;
				rx_index = <2>;
				status = "disabled";
			};

			rx2_sensing_d@14 {
				compatible = "sensing,sensing-cam";
				reg = <0x14>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx2_ser_d>;
				d-robotics,serdes-dser-device = <&rx2_dser>;
				status = "disabled";

				port {
					rx2_sensor_d_out: endpoint {
						virtual-channel = <3>;
					};
				};
			};
		};
	};

	fragment@3 {
		target-path = "/soc/i2c@34843000/"; /* I2C3 */
		__overlay__ {
			status = "okay";
			clock-frequency = <100000>;

			rx3_dser: rx3_max96712@29 {
				compatible = "d-robotics,max96712";
				reg = <0x29>;
				phy_type = <1>; /* C-PHY */
				phy_speed = <3648>; /* C-PHY 1600 Msps/trio: DPLL code 0x10 */
				sensing,trigger-period-ns = <33333333>;
				sensing,trigger-duty-ns = <10000>;
				pwdn-gpios = <&peri_port0 7 GPIO_ACTIVE_HIGH>;
				poc_en-gpios = <&gpio_exp_27 3 GPIO_ACTIVE_HIGH>;
				soc_trig_pin = <5>;
				pwms = <&lpwm3 2 33333333 10000>;
				pwm-names = "sync";
				trig_src = <0>;
				trig_mode = <1>;
				status = "okay";
			};

			rx3_ser_prim: rx3_max9295_prim@40 {
				compatible = "d-robotics,max9295";
				reg = <0x40>;
				is-prim-ser;
				rx_index = <3>;
				status = "okay";
			};

			rx3_ser_a: rx3_max9295_a@41 {
				compatible = "d-robotics,max9295";
				reg = <0x41>;
				link-port = <0>;
				rx_index = <3>;
				status = "disabled";
			};

			rx3_sensing_a@11 {
				compatible = "sensing,sensing-cam";
				reg = <0x11>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx3_ser_a>;
				d-robotics,serdes-dser-device = <&rx3_dser>;
				status = "disabled";

				port {
					rx3_sensor_a_out: endpoint {
						virtual-channel = <0>;
					};
				};
			};

			rx3_ser_b: rx3_max9295_b@42 {
				compatible = "d-robotics,max9295";
				reg = <0x42>;
				link-port = <1>;
				rx_index = <3>;
				status = "disabled";
			};

			rx3_sensing_b@12 {
				compatible = "sensing,sensing-cam";
				reg = <0x12>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx3_ser_b>;
				d-robotics,serdes-dser-device = <&rx3_dser>;
				status = "disabled";

				port {
					rx3_sensor_b_out: endpoint {
						virtual-channel = <1>;
					};
				};
			};

			rx3_ser_c: rx3_max9295_c@43 {
				compatible = "d-robotics,max9295";
				reg = <0x43>;
				link-port = <2>;
				rx_index = <3>;
				status = "disabled";
			};

			rx3_sensing_c@13 {
				compatible = "sensing,sensing-cam";
				reg = <0x13>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx3_ser_c>;
				d-robotics,serdes-dser-device = <&rx3_dser>;
				status = "disabled";

				port {
					rx3_sensor_c_out: endpoint {
						virtual-channel = <2>;
					};
				};
			};

			rx3_ser_d: rx3_max9295_d@44 {
				compatible = "d-robotics,max9295";
				reg = <0x44>;
				link-port = <3>;
				rx_index = <3>;
				status = "disabled";
			};

			rx3_sensing_d@14 {
				compatible = "sensing,sensing-cam";
				reg = <0x14>;
				addr = <0x10>;
				width = <1920>;
				height = <1080>;
				data_type = <0x1e>;
				gmsl-link-rate = <6>;
				lane_num = <4>;
				mfp-reset = <0>;
				mfp-trigger = <7>;
				d-robotics,serdes-ser-device = <&rx3_ser_d>;
				d-robotics,serdes-dser-device = <&rx3_dser>;
				status = "disabled";

				port {
					rx3_sensor_d_out: endpoint {
