					};
				};
			};
		};
	};

	fragment@4 {
		target-path = "/soc/cim@0x37430000/"; /* CIM0 */
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target-path = "/soc/cim@0x37630000/"; /* CIM1 */
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target-path = "/soc/cim@0x37830000/"; /* CIM2 */
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target-path = "/soc/cim@0x37A30000/"; /* CIM3 */
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target-path = "/soc/mipi_host@0x37420000/"; /* MIPI RX0 */
		__overlay__ {
			status = "okay";
			ports {
				port@0 {
					rx0_mipi_vc0_in: endpoint {
						remote-endpoint = <&rx0_sensor_a_out>;
						clock-lanes = <0>;
						data-lanes = <1 2 3 4>;
						lane-rate = <10000>;
						vc_id = <0>;
						emb-en = <0>;
					};
				};
				port@1 {
					rx0_mipi_vc1_in: endpoint {
						remote-endpoint = <&rx0_sensor_b_out>;
						clock-lanes = <0>;
						data-lanes = <1 2 3 4>;
						lane-rate = <10000>;
						vc_id = <1>;
						emb-en = <0>;
					};
				};
				port@2 {
